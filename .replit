modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["notion:1.0.0", "google-calendar:1.0.0", "google-docs:1.0.0", "google-drive:1.0.0", "google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 8084
externalPort = 5000

[[ports]]
localPort = 18918
externalPort = 3000

[[ports]]
localPort = 18919
externalPort = 3001

[[ports]]
localPort = 18920
externalPort = 3002

[[ports]]
localPort = 18921
externalPort = 5173

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NOTION_COMPETITOR_DB_ID = "33e95050449b80bd8b05dfb50286809c"
NOTION_TASKS_DB_ID = "33e95050449b80f0b5aadb85ce282567"
